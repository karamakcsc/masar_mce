 "html": "<html lang=\"ar\" dir=\"rtl\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <style>\r\n        /* All styles are now embedded in the head for consistency */\r\n        body {\r\n            font-family: \"Arabic Typesetting\", \"Traditional Arabic\", Arial, sans-serif;\r\n            color: #000;\r\n            margin: 20px;\r\n        }\r\n        .header-table {\r\n            width: 100%;\r\n            direction: rtl;\r\n            border-collapse: collapse;\r\n        }\r\n        .header-table td {\r\n            vertical-align: middle;\r\n            padding: 5px 0;\r\n        }\r\n        .header-left {\r\n            text-align: center;\r\n            line-height: 1.7;\r\n        }\r\n        .header-left .title-large {\r\n            font-size: 28px;\r\n            font-weight: bold;\r\n        }\r\n        .header-left .title-medium {\r\n            font-size: 24px;\r\n        }\r\n        .header-right {\r\n            text-align: left;\r\n            padding-left: 20px;\r\n        }\r\n        .header-right img {\r\n            height: 100px;\r\n            display: block;\r\n        }\r\n        hr {\r\n            border: 1px solid #000;\r\n            margin: 10px 0 20px 0;\r\n        }\r\n        .info-table {\r\n            width: 100%;\r\n            direction: rtl;\r\n            margin-bottom: 20px;\r\n            border-collapse: collapse;\r\n        }\r\n        .info-table td {\r\n            width: 45%;\r\n            vertical-align: top;\r\n            text-align: right;\r\n            padding: 3px 0;\r\n        }\r\n        .info-table td:last-child {\r\n            width: 45%;\r\n            text-align: right;\r\n        }\r\n        .info-table p {\r\n            margin: 3px 0;\r\n        }\r\n        table.receipt-table {\r\n            width: 100%;\r\n            direction: rtl;\r\n            border-collapse: collapse;\r\n            table-layout: fixed;\r\n            font-size: 12px;\r\n            color: #000;\r\n        }\r\n        table.receipt-table th {\r\n            background-color: #d9d9d9;\r\n            font-weight: bold;\r\n            text-align: right;\r\n            border: 1px solid #000;\r\n            padding: 8px;\r\n            word-break: break-word;\r\n            overflow-wrap: break-word;\r\n        }\r\n        table.receipt-table td {\r\n            border: 1px solid #000;\r\n            padding: 5px;\r\n            text-align: right;\r\n            word-break: break-word;\r\n            overflow-wrap: break-word;\r\n        }\r\n        table.receipt-table th:nth-child(1) { width: 5%; }\r\n        table.receipt-table th:nth-child(2) { width: 13%; }\r\n        table.receipt-table th:nth-child(3) { width: 32%; }\r\n        table.receipt-table th:nth-child(4) { width: 13%; }\r\n        table.receipt-table th:nth-child(5) { width: 13%; }\r\n        table.receipt-table th:nth-child(6) { width: 12%; }\r\n        table.receipt-table th:nth-child(7) { width: 12%; }\r\n        table.receipt-table tbody tr:nth-child(even) {\r\n            background-color: #f9f9f9;\r\n        }\r\n        table.receipt-table tbody tr:nth-child(odd) {\r\n            background-color: #ffffff;\r\n        }\r\n        table.receipt-table tbody tr:hover {\r\n            background-color: #e6f7ff;\r\n        }\r\n        /* Print-specific adjustments */\r\n        @media print {\r\n            body { margin: 0; }\r\n            .header-right img { height: 80px; }\r\n            table.receipt-table { font-size: 12px; }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n    <!-- Header using table instead of flex -->\r\n    <table class=\"header-table\">\r\n        <tr>\r\n            <td class=\"header-left\">\r\n                <div class=\"title-large\">\u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0645\u0633\u0644\u062d\u0629 \u0627\u0644\u0623\u0631\u062f\u0646\u064a\u0629 \u2013 \u0627\u0644\u062c\u064a\u0634 \u0627\u0644\u0639\u0631\u0628\u064a</div>\r\n                <div class=\"title-medium\">\u0627\u0644\u0645\u0624\u0633\u0633\u0629 \u0627\u0644\u0627\u0633\u062a\u0647\u0644\u0627\u0643\u064a\u0629 \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629</div>\r\n                {% if doc.docstatus == 0 %}\r\n                    {% if doc.is_return == 1 %}\r\n                        <div class=\"title-medium\">\u0648\u0635\u0644 \u0625\u0631\u062c\u0627\u0639 \u0637\u0644\u0628\u064a\u0629 \u0623\u0633\u0648\u0627\u0642 (\u0645\u0633\u0648\u062f\u0629)</div>\r\n                    {% else %}\r\n                        <div class=\"title-medium\">\u0648\u0635\u0644 \u0625\u0633\u062a\u0644\u0627\u0645 \u0637\u0644\u0628\u064a\u0629 \u0623\u0633\u0648\u0627\u0642 (\u0645\u0633\u0648\u062f\u0629)</div>\r\n                    {% endif %}\r\n                {% elif doc.docstatus == 1 %}\r\n                    {% if doc.is_return == 1 %}\r\n                        <div class=\"title-medium\">\u0648\u0635\u0644 \u0625\u0631\u062c\u0627\u0639 \u0637\u0644\u0628\u064a\u0629 \u0623\u0633\u0648\u0627\u0642</div>\r\n                    {% else %}\r\n                        <div class=\"title-medium\">\u0648\u0635\u0644 \u0625\u0633\u062a\u0644\u0627\u0645 \u0637\u0644\u0628\u064a\u0629 \u0623\u0633\u0648\u0627\u0642</div>\r\n                    {% endif %}\r\n                {% elif doc.docstatus == 2 %}\r\n                    {% if doc.is_return == 1 %}\r\n                        <div class=\"title-medium\">\u0648\u0635\u0644 \u0625\u0631\u062c\u0627\u0639 \u0637\u0644\u0628\u064a\u0629 \u0623\u0633\u0648\u0627\u0642 (\u0645\u0644\u063a\u0627\u0629)</div>\r\n                    {% else %}\r\n                        <div class=\"title-medium\">\u0648\u0635\u0644 \u0625\u0633\u062a\u0644\u0627\u0645 \u0637\u0644\u0628\u064a\u0629 \u0623\u0633\u0648\u0627\u0642 (\u0645\u0644\u063a\u0627\u0629)</div>\r\n                    {% endif %}\r\n                {% endif %}\r\n            </td>\r\n            <td class=\"header-right\">\r\n                <img src=\"/files/MCEHead.png\" alt=\"\" onerror=\"this.style.display='none'\">\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <hr>\r\n\r\n    <!-- Info section using table -->\r\n    <table class=\"info-table\">\r\n        <tr>\r\n            <td>\r\n                <p><b>\u0627\u0644\u0645\u0633\u062a\u0644\u0645: \u0645\u062f\u064a\u0631 </b>{{ doc.set_warehouse }}</p>\r\n                <p><b>\u0627\u0644\u0645\u0648\u0631\u062f </b>: {{ doc.supplier_name }}</p>\r\n                <p><b>\u0631\u0642\u0645 \u0627\u0644\u0648\u0635\u0644 :</b> {{ doc.name }}</p>\r\n                <p><b>\u0637\u0628\u0639 \u0628\u0648\u0627\u0633\u0637\u0629 :</b> {{ frappe.get_fullname(frappe.session.user) }}</p>\r\n            </td>\r\n            <td>\r\n                <p><b>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0633\u062a\u0644\u0627\u0645:</b> {{ doc.request_date }}</p>\r\n                <p><b>\u0648\u0642\u062a \u0627\u0644\u0625\u0633\u062a\u0644\u0627\u0645:</b> {{ frappe.utils.get_datetime(doc.modified).strftime('%H:%M:%S') }}</p>\r\n                <p><b>\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0629:</b> {{ frappe.utils.fmt_money(doc.total) }} \u062f\u064a\u0646\u0627\u0631 </p>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- Items table (unchanged, already compatible) -->\r\n    <table class=\"receipt-table\">\r\n        <thead>\r\n            <tr>\r\n                <th>#</th>\r\n                <th>\u0627\u0644\u0635\u0646\u0641</th>\r\n                <th>\u0627\u0633\u0645 \u0627\u0644\u0635\u0646\u0641</th>\r\n                <th>\u0627\u0644\u0643\u0645\u064a\u0629 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629</th>\r\n                <th>\u0627\u0644\u0643\u0645\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u0644\u0645\u0629</th>\r\n                <th>\u0627\u0644\u0633\u0639\u0631</th>\r\n                <th>\u0627\u0644\u0645\u0628\u0644\u063a</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for item in doc.items %}\r\n            <tr>\r\n                <td>{{ item.idx }}</td>\r\n                <td>{{ item.item_code or \"\" }}</td>\r\n                <td>{{ item.item_name or \"\" }}</td>\r\n                <td>{{ item.request_quantity }}</td>\r\n                <td>{{ item.received_qty }}</td>\r\n                <td>{{ frappe.utils.fmt_money(item.rate) }}</td>\r\n                <td>{{ frappe.utils.fmt_money(item.amount) }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n</body>\r\n</html>",
