 "css": "    body {\r\n            font-family: \"Traditional Arabic\", Tahoma, sans-serif;\r\n            font-size: 14px;\r\n            direction: rtl;\r\n            color: #000;\r\n        }\r\n\r\n        .header-table,\r\n        .info-table,\r\n        .items-table,\r\n        .signature-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            font-size: 14px;\r\n        }\r\n\r\n        .items-table {\r\n            margin-top: 15px;\r\n        }\r\n\r\n        .items-table th,\r\n        .items-table td {\r\n            border: 1px solid #000;\r\n            padding: 5px;\r\n            text-align: center;\r\n            vertical-align: middle;\r\n        }\r\n\r\n        .items-table th {\r\n            background-color: #f2f2f2;\r\n            font-weight: bold;\r\n        }\r\n\r\n        .section-title {\r\n            font-size: 24px;\r\n            text-align: center;\r\n            margin-top: 5px;\r\n        }\r\n\r\n        .committee-box {\r\n            border: 1px solid #000;\r\n            padding: 10px;\r\n            min-height: 80px;\r\n            margin-top: 15px;\r\n            line-height: 1.8;\r\n        }\r\n\r\n        .signature-table td {\r\n            text-align: center;\r\n            vertical-align: top;\r\n            padding-top: 10px;\r\n        }\r\n\r\n        .signature-line {\r\n            padding-top: 50px;\r\n        }\r\n\r\n        hr {\r\n            border: 0;\r\n            border-top: 1px solid #000;\r\n            margin-top: 10px;\r\n            margin-bottom: 15px;\r\n        }\r\n\r\n        .info-table td {\r\n            padding: 4px;\r\n            vertical-align: top;\r\n            text-align: right;\r\n        }",
 "custom_format": 1,
 "default_print_language": "en",
