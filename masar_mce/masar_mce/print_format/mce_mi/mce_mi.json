 "doctype": "Print Format",
 "font_size": 14,
 "html": "<html lang=\"ar\" dir=\"rtl\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <div style=\"width:100%; display:flex; align-items:center; justify-content:space-between; direction:rtl;\">\r\n        <div style=\"flex:1; text-align:center; line-height:1.7; font-family:'Arabic Typesetting','Traditional Arabic',serif;\">\r\n            <div style=\"font-size:28px; font-weight:bold;\">\r\n                \u0627\u0644\u0642\u064a\u0627\u062f\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0645\u0633\u0644\u062d\u0629 \u0627\u0644\u0623\u0631\u062f\u0646\u064a\u0629 \u2013 \u0627\u0644\u062c\u064a\u0634 \u0627\u0644\u0639\u0631\u0628\u064a\r\n            </div>\r\n            <div style=\"font-size:24px;\">\u0627\u0644\u0645\u0624\u0633\u0633\u0629 \u0627\u0644\u0627\u0633\u062a\u0647\u0644\u0627\u0643\u064a\u0629 \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629</div>\r\n\r\n            {% if doc.docstatus == 0 %}\r\n                    <div class=\"section-title\">\r\n                        \u0645\u062d\u0636\u0631 \u0641\u062d\u0635 \u0648\u0627\u0633\u062a\u0644\u0627\u0645 \u0645\u0648\u0627\u062f (\u0645\u0633\u0648\u062f\u0629)\r\n                    </div>\r\n                {% elif doc.docstatus == 1 %}\r\n                    <div class=\"section-title\">\r\n                        \u0645\u062d\u0636\u0631 \u0641\u062d\u0635 \u0648\u0627\u0633\u062a\u0644\u0627\u0645 \u0645\u0648\u0627\u062f\r\n                    </div>\r\n                {% elif doc.docstatus == 2 %}\r\n                    <div class=\"section-title\">\r\n                        \u0645\u062d\u0636\u0631 \u0641\u062d\u0635 \u0648\u0627\u0633\u062a\u0644\u0627\u0645 \u0645\u0648\u0627\u062f (\u0645\u0644\u063a\u0649)\r\n                    </div>\r\n                {% endif %}\r\n        </div>\r\n\r\n        <div style=\"flex:0 0 auto; margin-left:20px;\">\r\n            <img src=\"/files/MCEHead.png\" style=\"height:100px; display:block;\">\r\n        </div>\r\n    </div>\r\n\r\n    <br>\r\n    <hr>\r\n</head>\r\n\r\n<body>\r\n\r\n    \r\n\r\n    <!-- Document Information -->\r\n    <table class=\"info-table\">\r\n        <tr>\r\n            <td width=\"50%\">\r\n                <b>\u0631\u0642\u0645 \u0645\u062d\u0636\u0631 \u0627\u0644\u0641\u062d\u0635:</b> {{ doc.name }}\r\n            </td>\r\n\r\n            <td width=\"50%\">\r\n                <b>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u062d\u0635:</b> {{ doc.supply_date }}\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td>\r\n                <b>\u0631\u0642\u0645 \u0633\u0646\u062f \u0627\u0644\u0627\u0633\u062a\u0644\u0627\u0645:</b> {{ doc.purchase_receipt or \"-\" }}\r\n            </td>\r\n\r\n            <td>\r\n                <b>\u0646\u0648\u0639 \u0627\u0644\u0641\u062d\u0635:</b>\r\n\r\n            {% if doc.material_inspection_type == \"Receiving Verificatied\" %}\r\n                \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0627\u0633\u062a\u0644\u0627\u0645\r\n            {% elif doc.material_inspection_type == \"Inspection Template\" %}\r\n                \u0641\u062d\u0635 \u0627\u0644\u0645\u0648\u0627\u062f\r\n            {% else %}\r\n                {{ doc.material_inspection_type or \"-\" }}\r\n            {% endif %}\r\n            </td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td>\r\n                <b>\u0627\u0644\u0645\u0648\u0631\u062f:</b> {{ doc.supplier_name or doc.supplier or \"-\" }}\r\n            </td>\r\n\r\n            <td>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- Items Table -->\r\n    <table class=\"items-table\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"width:2%;\">\u0645</th>\r\n                <th style=\"width:6%;\">\u0631\u0642\u0645 \u0627\u0644\u0635\u0646\u0641</th>\r\n                <th style=\"width:11%;\">\u0627\u0633\u0645 \u0627\u0644\u0635\u0646\u0641</th>\r\n                <th style=\"width:8%;\">\u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629</th>\r\n                <th style=\"width:6%;\">\u0628\u0644\u062f \u0627\u0644\u0645\u0646\u0634\u0623</th>\r\n                <th style=\"width:5%;\">\u0627\u0644\u0648\u0632\u0646</th>\r\n                <th style=\"width:6%;\">\u0627\u0644\u0643\u0645\u064a\u0629 \u0627\u0644\u0645\u0648\u0631\u062f\u0629</th>\r\n                <th style=\"width:6%;\">\u0633\u0639\u0631 \u0627\u0644\u0628\u0639</th>\r\n                <th style=\"width:8%;\">\u0631\u0642\u0645 \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u0629</th>\r\n                <th style=\"width:10%;\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0646\u062a\u0627\u062c</th>\r\n                <th style=\"width:10%;\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621</th>\r\n                <th style=\"width:10%;\">\u0645\u062f\u0629 \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0629</th>\r\n                <th style=\"width:22%;\">\u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u062e\u0628\u0631\u064a\u0629</th>\r\n            </tr>\r\n        </thead>\r\n\r\n        <tbody>\r\n    {% for item in doc.items %}\r\n    <tr>\r\n        <td>{{ loop.index }}</td>\r\n        <td>{{ item.item_code or \"\" }}</td>\r\n        <td>{{ item.item_name or \"\" }}</td>\r\n        <td>{{ item.brand or \"\" }}</td>\r\n        <td>{{ item.country or \"\" }}</td>\r\n        <td>{{ item.weight or 0 }}</td>\r\n        <td>{{ item.quantity_supplied or 0 }}</td>\r\n        <td>{{ item.selling_price or 0 }}</td>\r\n        <td>{{ item.batch_number or \"\" }}</td>\r\n\r\n        <td>\r\n            {{ frappe.utils.formatdate(item.production_date, \"dd-MM-yyyy\") if item.production_date else \"\" }}\r\n        </td>\r\n\r\n        <td>\r\n            {{ frappe.utils.formatdate(item.expiry_date, \"dd-MM-yyyy\") if item.expiry_date else \"\" }}\r\n        </td>\r\n\r\n        <!-- Product Lifespan Translation -->\r\n        <td>\r\n            {% if item.product_lifespan %}\r\n                {% set lifespan = item.product_lifespan %}\r\n\r\n                {% set lifespan = lifespan.replace('years', '\u0633\u0646\u0648\u0627\u062a \u0648 ') %}\r\n                {% set lifespan = lifespan.replace('year', '\u0633\u0646\u0629 \u0648 ') %}\r\n                {% set lifespan = lifespan.replace('months', '\u0623\u0634\u0647\u0631') %}\r\n                {% set lifespan = lifespan.replace('month', '\u0634\u0647\u0631') %}\r\n\r\n                {{ lifespan }}\r\n            {% endif %}\r\n        </td>\r\n\r\n        <!-- Laboratory Remarks Translation -->\r\n        <td style=\"text-align:right;\">\r\n            {% if item.laboratory_remarks == \"Conforming without any issues\" %}\r\n                \u0645\u0637\u0627\u0628\u0642 \u0644\u0644\u0645\u0648\u0627\u0635\u0641\u0627\u062a \u0648\u062e\u0627\u0644\u064d \u0645\u0646 \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a\r\n\r\n            {% elif item.laboratory_remarks == \"Non-conforming with a note indicating physical damage\" %}\r\n                \u063a\u064a\u0631 \u0645\u0637\u0627\u0628\u0642 \u0645\u0639 \u0648\u062c\u0648\u062f \u0636\u0631\u0631 \u0645\u0627\u062f\u064a\r\n\r\n            {% elif item.laboratory_remarks == \"Unfit for human consumption\" %}\r\n                \u063a\u064a\u0631 \u0635\u0627\u0644\u062d \u0644\u0644\u0627\u0633\u062a\u0647\u0644\u0627\u0643 \u0627\u0644\u0628\u0634\u0631\u064a\r\n\r\n            {% elif item.laboratory_remarks == \"Unsuitable for use\" %}\r\n                \u063a\u064a\u0631 \u0635\u0627\u0644\u062d \u0644\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645\r\n\r\n            {% elif item.laboratory_remarks == \"Not recommended for sale\" %}\r\n                \u063a\u064a\u0631 \u0645\u0648\u0635\u0649 \u0628\u0637\u0631\u062d\u0647 \u0644\u0644\u0628\u064a\u0639\r\n\r\n            {% else %}\r\n                {{ item.laboratory_remarks or \"\" }}\r\n            {% endif %}\r\n        </td>\r\n    </tr>\r\n    {% endfor %}\r\n</tbody>\r\n    </table>\r\n\r\n    <!-- Committee Decision -->\r\n    <div class=\"committee-box\">\r\n        <b>\u0642\u0631\u0627\u0631 \u0644\u062c\u0646\u0629 \u0627\u0644\u0641\u062d\u0635:</b>\r\n        <br><br>\r\n\r\n        \u062a\u0645 \u0641\u062d\u0635 \u0627\u0644\u0645\u0648\u0627\u062f \u0627\u0644\u0648\u0627\u0631\u062f\u0629 \u0623\u0639\u0644\u0627\u0647 \u0648\u0627\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u0645\u0637\u0627\u0628\u0642\u062a\u0647\u0627 \u0644\u0644\u0645\u0648\u0627\u0635\u0641\u0627\u062a \u0648\u0627\u0644\u0634\u0631\u0648\u0637 \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629\u060c\r\n        \u0648\u0628\u0646\u0627\u0621\u064b \u0639\u0644\u064a\u0647 \u0623\u0648\u0635\u062a \u0627\u0644\u0644\u062c\u0646\u0629 \u0628\u0627\u0633\u062a\u0644\u0627\u0645 \u0627\u0644\u0645\u0648\u0627\u062f \u0648\u0642\u0628\u0648\u0644\u0647\u0627 \u0645\u0627 \u0644\u0645 \u064a\u0631\u062f \u062e\u0644\u0627\u0641 \u0630\u0644\u0643 \u0641\u064a \u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0623\u0639\u0644\u0627\u0647.\r\n    </div>\r\n\r\n    <!-- First Signature Row -->\r\n    <!-- First Signature Row -->\r\n<table class=\"signature-table\" style=\"margin-top:40px;\">\r\n    <tr>\r\n        <td width=\"33%\">\r\n            <b>\u0631\u0626\u064a\u0633 \u0644\u062c\u0646\u0629 \u0627\u0644\u0641\u062d\u0635</b>\r\n        </td>\r\n\r\n        <td width=\"33%\">\r\n            <b>\u0639\u0636\u0648 \u0644\u062c\u0646\u0629 \u0627\u0644\u0641\u062d\u0635</b>\r\n        </td>\r\n\r\n        <td width=\"33%\">\r\n            <b>\u0639\u0636\u0648 \u0644\u062c\u0646\u0629 \u0627\u0644\u0641\u062d\u0635</b>\r\n        </td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td class=\"signature-line\" style=\"text-align:center;height:80px;\">\r\n            {% if doc.chairman_of_the_committee %}\r\n                <img src=\"{{ doc.chairman_of_the_committee }}\" style=\"max-height:70px; max-width:180px;\">\r\n            {% else %}\r\n                ______________________\r\n            {% endif %}\r\n        </td>\r\n\r\n        <td class=\"signature-line\" style=\"text-align:center;height:80px;\">\r\n            {% if doc.member1 %}\r\n                <img src=\"{{ doc.member1 }}\" style=\"max-height:70px; max-width:180px;\">\r\n            {% else %}\r\n                ______________________\r\n            {% endif %}\r\n        </td>\r\n\r\n        <td class=\"signature-line\" style=\"text-align:center;height:80px;\">\r\n            {% if doc.member2 %}\r\n                <img src=\"{{ doc.member2 }}\" style=\"max-height:70px; max-width:180px;\">\r\n            {% else %}\r\n                ______________________\r\n            {% endif %}\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n<!-- Second Signature Row -->\r\n<table class=\"signature-table\" style=\"margin-top:30px;\">\r\n    <tr>\r\n        <td width=\"33%\">\r\n            <b>\u0623\u0645\u064a\u0646 \u0627\u0644\u0645\u0633\u062a\u0648\u062f\u0639</b>\r\n        </td>\r\n\r\n        <td width=\"33%\">\r\n            <b>\u0645\u0646\u062f\u0648\u0628 \u0627\u0644\u0645\u0648\u0631\u062f</b>\r\n        </td>\r\n\r\n        <td width=\"33%\">\r\n            <b>\u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u062e\u062a\u0635\u0629</b>\r\n        </td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td class=\"signature-line\" style=\"text-align:center;height:80px;\">\r\n            {% if doc.warehouse_keeper %}\r\n                <img src=\"{{ doc.warehouse_keeper }}\" style=\"max-height:70px; max-width:180px;\">\r\n            {% else %}\r\n                ______________________\r\n            {% endif %}\r\n        </td>\r\n\r\n        <td class=\"signature-line\" style=\"text-align:center;height:80px;\">\r\n            {% if doc.member3 %}\r\n                <img src=\"{{ doc.member3 }}\" style=\"max-height:70px; max-width:180px;\">\r\n            {% else %}\r\n                ______________________\r\n            {% endif %}\r\n        </td>\r\n\r\n        <td class=\"signature-line\" style=\"text-align:center;height:80px;\">\r\n            {% if doc.agreement_accountant %}\r\n                <img src=\"{{ doc.agreement_accountant }}\" style=\"max-height:70px; max-width:180px;\">\r\n            {% else %}\r\n                ______________________\r\n            {% endif %}\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n</body>\r\n</html>",
